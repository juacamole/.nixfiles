+static void ggml_salz_wrap_should_stop(const httplib::Request & req) {
+    auto & f = const_cast<std::function<bool()> &>(req.is_connection_closed);
+    f = [orig = f]() { return g_server_shutting_down.load() || (orig && orig()); };
